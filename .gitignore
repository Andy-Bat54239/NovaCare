logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment / secrets
.env
.env.local
*.env
*.local

# Editor files
.vscode/*
!.vscode/extensions.json
CLAUDE.md
.DS_Store
Thumbs.db
*.suo
*.user
*.ntvs*
*.njsproj
